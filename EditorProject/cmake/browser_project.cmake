if(NOT EMSCRIPTEN OR NOT TARGET NauFrameworkScene)
  message(FATAL_ERROR "Configure through NauEngine using NauEngineModules/cmake/attach_browser_project.cmake.")
endif()
add_subdirectory(source/game/main_module)
add_executable(NauDemoMain source/browser_startup.cpp)
target_link_libraries(NauDemoMain PRIVATE NauFrameworkScene MainGameModule)
nau_target_link_modules(NauDemoMain PlatformApp CoreAssets CoreScene CoreSceneFormats MainGameModule)
nau_add_compile_options(NauDemoMain)
include("${NAU_MODULES_SOURCE_DIR}/cmake/NauBrowserProject.cmake")
nau_browser_project_delivery(NauDemoMain)
option(NAU_BROWSER_PROJECT_ACCEPTANCE "Build the independent scene observation consumer" OFF)
if(NAU_BROWSER_PROJECT_ACCEPTANCE)
  add_executable(NauDemoStartupProbe tests/startup_probe.cpp)
  target_link_libraries(NauDemoStartupProbe PRIVATE NauFrameworkScene MainGameModule)
  nau_target_link_modules(NauDemoStartupProbe PlatformApp CoreAssets CoreScene CoreSceneFormats MainGameModule)
  nau_add_compile_options(NauDemoStartupProbe)
  nau_browser_project_delivery(NauDemoStartupProbe DESTINATION "${CMAKE_BINARY_DIR}/probe-package")
endif()
