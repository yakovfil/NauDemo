# Battlezone (1980), Atari; extracted from rev-2 disassembly
# Source: https://6502disassembly.com/va-battlezone/Battlezone.html
# Right-handed: +X right, +Y up, -Z forward; original units
# ROM object 0x24; vertex 0x3d28; draw 0x75f4
o 24_spatter_0
v -26 -180 0
v -18 -180 -18
v 0 -180 -26
v 18 -180 -18
v 26 -180 0
v 18 -180 18
v 0 -180 26
v -18 -180 18
p 1
p 2
p 3
p 4
p 5
p 6
p 7
p 8
