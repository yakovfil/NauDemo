# Battlezone (1980), Atari; extracted from rev-2 disassembly
# Source: https://6502disassembly.com/va-battlezone/Battlezone.html
# Right-handed: +X right, +Y up, -Z forward; original units
# ROM object 0x13; vertex 0x3b0e; draw 0x752d
o 13_tank_radar_chunk
v 40 80 0
v 80 100 -40
v 80 120 -40
v 40 140 0
v -40 80 0
v -80 100 -40
v -80 120 -40
v -40 140 0
l 1 2
l 2 3
l 3 4
l 4 1
l 1 5
l 5 6
l 6 7
l 7 8
l 8 5
l 8 4
