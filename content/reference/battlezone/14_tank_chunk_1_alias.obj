v -80 -384 -360
v 60 -320 -320
v 32 -80 20
v -16 -60 0
v 80 -200 -28
v -100 -240 -60
l 1 2
l 2 3
l 3 4
l 4 1
l 1 5
l 5 7
l 7 8
l 8 6
l 6 5
l 6 2
l 8 3
