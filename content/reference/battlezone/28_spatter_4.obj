# Battlezone (1980), Atari; extracted from rev-2 disassembly
# Source: https://6502disassembly.com/va-battlezone/Battlezone.html
# Right-handed: +X right, +Y up, -Z forward; original units
# ROM object 0x28; vertex 0x3dec; draw 0x75f4
o 28_spatter_4
v -126 -260 0
v -88 -260 -88
v 0 -260 -126
v 88 -260 -88
v 126 -260 0
v 88 -260 88
v 0 -260 126
v -88 -260 88
p 1
p 2
p 3
p 4
p 5
p 6
p 7
p 8
