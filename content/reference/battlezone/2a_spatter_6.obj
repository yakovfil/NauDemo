# Battlezone (1980), Atari; extracted from rev-2 disassembly
# Source: https://6502disassembly.com/va-battlezone/Battlezone.html
# Right-handed: +X right, +Y up, -Z forward; original units
# ROM object 0x2a; vertex 0x3e4e; draw 0x75f4
o 2a_spatter_6
v -176 -300 0
v -132 -300 -132
v 0 -300 -176
v 132 -300 -132
v 176 -300 0
v 132 -300 132
v 0 -300 176
v -132 -300 132
p 1
p 2
p 3
p 4
p 5
p 6
p 7
p 8
