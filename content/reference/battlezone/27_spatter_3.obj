# Battlezone (1980), Atari; extracted from rev-2 disassembly
# Source: https://6502disassembly.com/va-battlezone/Battlezone.html
# Right-handed: +X right, +Y up, -Z forward; original units
# ROM object 0x27; vertex 0x3dbb; draw 0x75f4
o 27_spatter_3
v -100 -240 0
v -72 -240 -72
v 0 -240 -100
v 72 -240 -72
v 100 -240 0
v 72 -240 72
v 0 -240 100
v -72 -240 72
p 1
p 2
p 3
p 4
p 5
p 6
p 7
p 8
