# Battlezone (1980), Atari; extracted from rev-2 disassembly
# Source: https://6502disassembly.com/va-battlezone/Battlezone.html
# Right-handed: +X right, +Y up, -Z forward; original units
# ROM object 0x2b; vertex 0x3e7f; draw 0x75f4
o 2b_spatter_7
v -200 -320 0
v -142 -320 -142
v 0 -320 -200
v 142 -320 -142
v 200 -320 0
v 142 -320 142
v 0 -320 200
v -142 -320 142
p 1
p 2
p 3
p 4
p 5
p 6
p 7
p 8
