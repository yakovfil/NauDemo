add_subdirectory(source/game/main_module)
if(NOT TARGET ${NAU_PACKAGED_PROJECT_GAME_MODULE})
  message(FATAL_ERROR "Declared project module target is missing: ${NAU_PACKAGED_PROJECT_GAME_MODULE}")
endif()
add_executable(NauDemoMain source/portable_main.cpp)
target_include_directories(NauDemoMain PRIVATE "${CMAKE_BINARY_DIR}/generated")
target_link_libraries(NauDemoMain PRIVATE NauFrameworkScene ${NAU_PACKAGED_PROJECT_GAME_MODULE})
nau_target_link_modules(NauDemoMain ${NAU_PACKAGED_PROJECT_MODULES} ${NAU_PACKAGED_PROJECT_GAME_MODULE})
nau_add_compile_options(NauDemoMain)
include("${NAU_MODULES_SOURCE_DIR}/cmake/NauPackagedProject.cmake")
add_executable(NauBattlezoneTests tests/test_battlezone.cpp)
target_include_directories(NauBattlezoneTests PRIVATE source/game/main_module)
target_link_libraries(NauBattlezoneTests PRIVATE gtest_main)
nau_add_compile_options(NauBattlezoneTests)
if(EMSCRIPTEN)
  target_link_options(NauBattlezoneTests PRIVATE -sEXIT_RUNTIME=1)
endif()
nau_packaged_project_delivery(NauDemoMain)
if(NAU_PORTABLE_INPUT_TESTS AND TARGET CoreInput)
  add_executable(NauFreeCameraTests tests/test_free_camera.cpp)
  target_include_directories(NauFreeCameraTests PRIVATE source/game/main_module)
  target_link_libraries(NauFreeCameraTests PRIVATE NauKernel gtest_main)
  nau_target_link_modules(NauFreeCameraTests ${NAU_PACKAGED_PROJECT_MODULES} ${NAU_PACKAGED_PROJECT_GAME_MODULE})
  nau_add_compile_options(NauFreeCameraTests)
  if(EMSCRIPTEN)
    target_link_options(NauFreeCameraTests PRIVATE -sEXIT_RUNTIME=1)
  endif()
endif()
option(NAU_BROWSER_PROJECT_ACCEPTANCE "Build the independent scene observation consumer" OFF)
if(NAU_BROWSER_PROJECT_ACCEPTANCE)
  if(TARGET SceneRenderer AND TARGET Audio AND TARGET CoreInput)
    add_executable(NauBattlezoneProbe tests/battlezone_probe.cpp)
    target_compile_definitions(NauBattlezoneProbe PRIVATE NAU_DEMO_PORTABLE_VECTORS)
    target_include_directories(NauBattlezoneProbe PRIVATE source/game/main_module "${CMAKE_BINARY_DIR}/generated")
    target_link_libraries(NauBattlezoneProbe PRIVATE SceneRenderer Audio CoreInput NauFrameworkScene ${NAU_PACKAGED_PROJECT_GAME_MODULE})
    nau_target_link_modules(NauBattlezoneProbe ${NAU_PACKAGED_PROJECT_MODULES} ${NAU_PACKAGED_PROJECT_GAME_MODULE})
    nau_add_compile_options(NauBattlezoneProbe)
    nau_packaged_project_delivery(NauBattlezoneProbe DESTINATION "${CMAKE_BINARY_DIR}/battlezone-probe-package")
  endif()
  if(TARGET CoreInput AND NAU_PACKAGED_PROJECT_RUNTIME_PROFILE STREQUAL "basic-rendering-scene")
    add_executable(NauDemoInputProbe tests/input_probe.cpp)
    target_include_directories(NauDemoInputProbe PRIVATE "${CMAKE_BINARY_DIR}/generated")
    target_link_libraries(NauDemoInputProbe PRIVATE NauFrameworkScene SceneRenderer CoreInput ${NAU_PACKAGED_PROJECT_GAME_MODULE})
    if(TARGET Audio)
      target_link_libraries(NauDemoInputProbe PRIVATE Audio)
      target_compile_definitions(NauDemoInputProbe PRIVATE NAU_DEMO_AUDIO_PROBE)
    endif()
    nau_target_link_modules(NauDemoInputProbe ${NAU_PACKAGED_PROJECT_MODULES} ${NAU_PACKAGED_PROJECT_GAME_MODULE})
    nau_add_compile_options(NauDemoInputProbe)
    nau_packaged_project_delivery(NauDemoInputProbe DESTINATION "${CMAKE_BINARY_DIR}/input-probe-package")
  endif()
  if(NAU_PACKAGED_PROJECT_RUNTIME_PROFILE STREQUAL "basic-rendering-scene")
    add_executable(NauSceneRenderingProbe tests/rendering_probe.cpp)
    target_include_directories(NauSceneRenderingProbe PRIVATE "${CMAKE_BINARY_DIR}/generated" "${CMAKE_BINARY_DIR}/generated/scene_renderer")
    target_link_libraries(NauSceneRenderingProbe PRIVATE NauFrameworkScene SceneRenderer ${NAU_PACKAGED_PROJECT_GAME_MODULE})
    if(EMSCRIPTEN)
      target_link_libraries(NauSceneRenderingProbe PRIVATE NauBrowserRenderer)
    endif()
    nau_target_link_modules(NauSceneRenderingProbe ${NAU_PACKAGED_PROJECT_MODULES} ${NAU_PACKAGED_PROJECT_GAME_MODULE})
    nau_add_compile_options(NauSceneRenderingProbe)
    nau_packaged_project_delivery(NauSceneRenderingProbe DESTINATION "${CMAKE_BINARY_DIR}/probe-package")
    if(EMSCRIPTEN)
      add_custom_target(NauDemoMainAcceptancePackage DEPENDS NauSceneRenderingProbeWebPackage)
      if(TARGET NauDemoInputProbeWebPackage)
        add_dependencies(NauDemoMainAcceptancePackage NauDemoInputProbeWebPackage)
      endif()
    else()
      add_custom_target(NauDemoMainAcceptancePackage DEPENDS NauSceneRenderingProbePackage)
      if(TARGET NauDemoInputProbePackage)
        add_dependencies(NauDemoMainAcceptancePackage NauDemoInputProbePackage)
      endif()
    endif()
    return()
  endif()
  add_executable(NauDemoStartupProbe tests/startup_probe.cpp)
  target_include_directories(NauDemoStartupProbe PRIVATE "${CMAKE_BINARY_DIR}/generated")
  target_compile_definitions(NauDemoStartupProbe PRIVATE NAU_PACKAGED_PROJECT_TEST=1)
  target_link_libraries(NauDemoStartupProbe PRIVATE NauFrameworkScene ${NAU_PACKAGED_PROJECT_GAME_MODULE})
  nau_target_link_modules(NauDemoStartupProbe ${NAU_PACKAGED_PROJECT_MODULES} ${NAU_PACKAGED_PROJECT_GAME_MODULE})
  nau_add_compile_options(NauDemoStartupProbe)
  nau_packaged_project_delivery(NauDemoStartupProbe DESTINATION "${CMAKE_BINARY_DIR}/probe-package")
  if(EMSCRIPTEN)
    add_custom_target(NauDemoMainAcceptancePackage DEPENDS NauDemoStartupProbeWebPackage)
  else()
    add_custom_target(NauDemoMainAcceptancePackage DEPENDS NauDemoStartupProbePackage)
  endif()
endif()
