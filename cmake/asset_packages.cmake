set(NAU_ASSET_PACKER "${CMAKE_CURRENT_SOURCE_DIR}/build/asset-pack-host/bin/Release/AssetPackToolCmd.exe" CACHE FILEPATH "Native AssetPackToolCmd executable")
if(NOT EXISTS "${NAU_ASSET_PACKER}")
  message(FATAL_ERROR "Missing native asset packer: ${NAU_ASSET_PACKER}. Run NauDemo/cmake/build_asset_packer.ps1 or provide -DNAU_ASSET_PACKER=<native executable>.")
endif()
set(DEMO "${CMAKE_CURRENT_SOURCE_DIR}")
file(TO_CMAKE_PATH "${NAU_SAMPLES_SOURCE_DIR}" SAMPLES)

function(nau_demo_package template manifest output)
  file(READ "${template}" text)
  string(CONFIGURE "${text}" configured @ONLY)
  file(GENERATE OUTPUT "${manifest}" CONTENT "${configured}")
  string(JSON count LENGTH "${configured}" files)
  math(EXPR last "${count}-1")
  set(inputs)
  set(paths)
  foreach(index RANGE 0 ${last})
    string(JSON source GET "${configured}" files ${index} source)
    list(APPEND inputs "${source}")
    string(JSON path GET "${configured}" files ${index} path)
    list(APPEND paths "${path}")
  endforeach()
  add_custom_command(OUTPUT "${output}"
    COMMAND "${NAU_ASSET_PACKER}" --manifest "${manifest}" --output "${output}"
    DEPENDS "${template}" "${manifest}" ${inputs} "${NAU_ASSET_PACKER}" VERBATIM)
  set(NAU_DEMO_PACKAGED_PATHS "${paths}" PARENT_SCOPE)
endfunction()
